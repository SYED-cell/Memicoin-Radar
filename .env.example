# MemeCoin Radar server configuration. Copy to .env.local (git-ignored).
# Every value here is read ONLY by the Node server — nothing is shipped to the browser.

# ── Required in production ──────────────────────────────────────────────
NODE_ENV=production
# 64+ hex chars each, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
APP_URL=https://your-domain.example
# Email delivery for verification / password reset (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=MemeCoin Radar <alerts@your-domain.example>

# ── Data providers ──────────────────────────────────────────────────────
# Dedicated Solana RPC (Helius / Triton / QuickNode URL incl. key). Needed for holder lists.
SOLANA_RPC_URL=
# Optional comma-separated fallback RPCs (the public RPC is always the last fallback)
SOLANA_RPC_FALLBACK_URLS=
# PumpPortal key: enables the per-trade stream (creator sells, whale sells, trade feed)
PUMPPORTAL_API_KEY=
# Telegram bot token from @BotFather: enables verified-coin alerts
TELEGRAM_BOT_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────
# API_PORT=8787
# HOST=127.0.0.1
# DATABASE_PATH=data/radar.db
# CORS_ORIGINS=https://your-domain.example
# TRUST_PROXY=true
# DATA_MODE=live        # 'mock' = offline demo data for development only
# REQUIRE_EMAIL_VERIFICATION=true
