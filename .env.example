# MemeCoin Radar server configuration. Copy to .env.local (git-ignored).
# Every value here is read ONLY by the Node server — nothing is shipped to the browser.

# ── Required in production ──────────────────────────────────────────────
NODE_ENV=production
# 64+ hex chars each, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
APP_URL=https://your-domain.example
# Email delivery for verification / password reset (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=MemeCoin Radar <alerts@your-domain.example>

# ── Data providers ──────────────────────────────────────────────────────
# Dedicated Solana RPC (Helius / Triton / QuickNode URL incl. key). Needed for holder lists.
SOLANA_RPC_URL=
# Optional comma-separated fallback RPCs (the public RPC is always the last fallback)
SOLANA_RPC_FALLBACK_URLS=
# PumpPortal key: enables the per-trade stream (creator sells, whale sells, trade feed)
PUMPPORTAL_API_KEY=
# ave.ai token data — cross-checks market cap and liquidity when set (https://ave.ai)
AVE_API_KEY=
# Robinhood: stored server-side for reading account data. This app places no orders; adding a key
# does not enable trading, and real-money execution must be wired and authorised deliberately.
ROBINHOOD_API_KEY=
ROBINHOOD_API_SECRET=
# Telegram bot token from @BotFather: enables verified-coin alerts
TELEGRAM_BOT_TOKEN=

# ── Pro subscriptions (USDT) ─────────────────────────────────────────────
# Wallets you control. This server never holds keys and cannot move funds; a payment is confirmed
# by reading the chain. Leave both empty to disable upgrades.
USDT_TRC20_ADDRESS=
USDT_ERC20_ADDRESS=
# PRO_PRICE_USDT=29
# PRO_DAYS=30
# Free API keys used to confirm incoming transfers. ERC20 cannot be confirmed without Etherscan.
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────
# API_PORT=8787        # hosts that inject PORT (Railway, Render) are picked up automatically
# HOST=127.0.0.1       # defaults to 0.0.0.0 in production so containers are reachable
# DATABASE_PATH=data/radar.db   # on Railway/Render point this at the mounted volume, e.g. /data/radar.db
# CORS_ORIGINS=https://your-domain.example
# TRUST_PROXY=true
# DATA_MODE=live        # 'mock' = offline demo data for development only
# REQUIRE_EMAIL_VERIFICATION=true
